{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Buero",
  "version": "0.13.0",
  "identifier": "de.buero.desktop",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:8081",
    "beforeDevCommand": { "script": "trunk serve", "cwd": "../web", "wait": false },
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": "../web" }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Büro",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "dragDropEnabled": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "copyright": "Copyright (C) 2026 Manfred Roßkamp",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "shortDescription": "Dokumentenverwaltung"
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "dangerousInsecureTransportProtocol": true,
      "requireSignedVersion": true
    }
  }
}
